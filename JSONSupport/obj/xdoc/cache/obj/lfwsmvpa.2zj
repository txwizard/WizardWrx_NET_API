      - JSONSupport
      namespace: WizardWrx.JsonSupport
      source:
        remote:
          path: JSONSupport/JSON_Deserialized_Object.cs
          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API
        id: GetFieldValueAsDouble
        path: ../JSONSupport/JSON_Deserialized_Object.cs
        startLine: 411
      summary: "\nQuery the JSON object for a specific field and returns its value as\na double, or null if the field does not exist or cannot be parsed as\na double.\n"
      remarks: "\n<p>\nThis method provides the canonical double precision floating point\nnumber accessor for this class.\n</p>\n<p>\nJSON numeric values are represented internally as doubles, and every\nvalid float value is also representable as a double. Because double is\nstrictly a superset of float in both range and precision, there is no\nscenario where a separate GetFieldValueAsFloat method would return a\nmeaningful result that this method cannot.\n</p>\n<p>\nCallers who require a float can cast the returned double value.\n</p>\n"
      example: []
      syntax:
        content:
          CSharp: public double? GetFieldValueAsDouble(string pstrFieldName)
          VB: Public Function GetFieldValueAsDouble(pstrFieldName As String) As Double?
        parameters:
        - id: pstrFieldName
          type: System.String
          description: "\nThis string represents the name of the field for which to get the\nvalue. The method will attempt to parse the value of this field as a\ndouble.\n"
        return:
          type: System.Nullable{System.Double}
          description: "\nThe return value is a nullable double representing the value of the field,\nor null if the field does not exist or cannot be parsed as a double.\n"
      overload: WizardWrx.JsonSupport.JSON_Deserialized_Object.GetFieldValueAsDouble*
      modifiers:
        CSharp:
        - public
        VB:
        - Public
    - id: WizardWrx.JsonSupport.JSON_Deserialized_Object.GetFieldValueAsGuid(System.String)
      commentId: M:WizardWrx.JsonSupport.JSON_Deserialized_Object.GetFieldValueAsGuid(System.String)
      language: CSharp
