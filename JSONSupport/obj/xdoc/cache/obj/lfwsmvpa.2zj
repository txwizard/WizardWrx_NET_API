    - id: WizardWrx.JsonSupport.JSON_Deserialized_Object.GetFieldValueAsInt(System.String)
      commentId: M:WizardWrx.JsonSupport.JSON_Deserialized_Object.GetFieldValueAsInt(System.String)
      language: CSharp
      name:
        CSharp: GetFieldValueAsInt(String)
