          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API
        id: GetFieldValueAsGuid
        path: ../JSONSupport/JSON_Deserialized_Object.cs
        startLine: 456
      summary: "\nQuery the JSON object for a specific field and attempt to parse it\nas a Guid.\n"
      remarks: "\n<p>\nThis method retrieves the field value as a Guid, which is a common\nrepresentation for identifiers in many JSON-based systems. JSON has no\nnative Guid type, so values are stored as strings and parsed here using\n<xref href=\"System.Guid.TryParse(System.String%2cSystem.Guid%40)\" data-throw-if-not-resolved=\"false\"></xref>.\n</p>\n<p>\nAdditional identifier getters (such as UInt64 or custom ID formats)\nare intentionally omitted, since callers with domain-specific\nidentifier requirements should interpret the raw string according to\ntheir own rules.\n</p>\n"
      example: []
      syntax:
        content:
          CSharp: public Guid? GetFieldValueAsGuid(string pstrFieldName)
          VB: Public Function GetFieldValueAsGuid(pstrFieldName As String) As Guid?
        parameters:
        - id: pstrFieldName
          type: System.String
          description: "\nThis string represents the name of the field for which to get the\nvalue. The method will attempt to parse the value of this field as a\nGuid.\n"
        return:
          type: System.Nullable{System.Guid}
          description: "\nThe return value is a nullable Guid representing the value of the field,\nor null if the field does not exist or cannot be parsed as a Guid.\n"
      overload: WizardWrx.JsonSupport.JSON_Deserialized_Object.GetFieldValueAsGuid*
      modifiers:
        CSharp:
        - public
        VB:
        - Public
      references:
