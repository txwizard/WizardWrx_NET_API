      nameWithType:
        CSharp: RequestOptions.RequestOptions(ExceptionLogger, RequestOptions.OAuthTokenGetter, String, String, String, String, Int32, Int32, RequestOptions.HttpEngineLogCallback)
        VB: RequestOptions.RequestOptions(ExceptionLogger, RequestOptions.OAuthTokenGetter, String, String, String, String, Int32, Int32, RequestOptions.HttpEngineLogCallback)
      qualifiedName:
        CSharp: WizardWrx.HTTP.RequestOptions.RequestOptions(WizardWrx.DLLConfigurationManager.ExceptionLogger, WizardWrx.HTTP.RequestOptions.OAuthTokenGetter, System.String, System.String, System.String, System.String, System.Int32, System.Int32, WizardWrx.HTTP.RequestOptions.HttpEngineLogCallback)
        VB: WizardWrx.HTTP.RequestOptions.RequestOptions(WizardWrx.DLLConfigurationManager.ExceptionLogger, WizardWrx.HTTP.RequestOptions.OAuthTokenGetter, System.String, System.String, System.String, System.String, System.Int32, System.Int32, WizardWrx.HTTP.RequestOptions.HttpEngineLogCallback)
      type: Constructor
      assemblies:
      - WizardWrx.HTTP
      namespace: WizardWrx.HTTP
      source:
        remote:
          path: HTTP/RequestOptions.cs
          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API
        id: .ctor
        path: ../HTTP/RequestOptions.cs
        startLine: 380
      summary: "\nThe public constructor initializes both read-only properties of this\nclass, so that consumers of this class must make their choices about\nthese properties explicit.\n"
      example: []
      syntax:
        content:
          CSharp: public RequestOptions(ExceptionLogger plogger = null, RequestOptions.OAuthTokenGetter ptokenGetter = null, string pstrInitialOAuthToken = null, string pstrAcceptHeaderValue = "*/*", string pstrAcceptEncodingValue = null, string pstrCacheControlValue = "no-cache", int pintRetryLimit = 10, int pintRetryDelay = 10, RequestOptions.HttpEngineLogCallback pdiLogCallback = null)
          VB: Public Sub New(plogger As ExceptionLogger = Nothing, ptokenGetter As RequestOptions.OAuthTokenGetter = Nothing, pstrInitialOAuthToken As String = Nothing, pstrAcceptHeaderValue As String = "*/*", pstrAcceptEncodingValue As String = Nothing, pstrCacheControlValue As String = "no-cache", pintRetryLimit As Integer = 10, pintRetryDelay As Integer = 10, pdiLogCallback As RequestOptions.HttpEngineLogCallback = Nothing)
        parameters:
        - id: plogger
          type: WizardWrx.DLLConfigurationManager.ExceptionLogger
          description: "\nThe ExceptionLogger instance to be used for logging Exceptions is\noptional; if no object is supplied, no Exception logging happens\ninside the other methods exposed by this library.\n"
        - id: ptokenGetter
          type: WizardWrx.HTTP.RequestOptions.OAuthTokenGetter
          description: "\nThe delegate that retrieves OAuth Bearer tokens for inclusion in the\nAuthorization header of HTTP requests is optional; if no delegate is\nprovided, requests proceed without Authorization headers.\n"
        - id: pstrInitialOAuthToken
          type: System.String
          description: "\nThis optional parameter allows the caller to supply an initial OAuth\ntoken that the class caches for future use. If this parameter is \nnull and <code data-dev-comment-type=\"paramref\" class=\"paramref\">ptokenGetter</code> is not null, the class \nattempts to obtain a token the first time the property value is\nqueried.\n"
        - id: pstrAcceptHeaderValue
          type: System.String
          description: "\nWhen specified, thiis string represents the value to include as the\nAccept HTTP header value. By default, the null value, &quot;/&quot;, is added.\n"
        - id: pstrAcceptEncodingValue
          type: System.String
          description: "\nWhen specified, this string represents the value to include as the\nAccept-Encoding HTTP header value. By default, this value is null,\nand is, therefore, omitted.\n"
        - id: pstrCacheControlValue
          type: System.String
          description: "\nWhen specified, this string represents the value to include as the\nCache-Control HTTP header value. The default  value is &quot;no-cache&quot;.\n"
        - id: pintRetryLimit
          type: System.Int32
          description: "\nThis integer specifies the maximum number of times to retry a\nrequest that fails due to a transient error, such as a network issue\nor a server error. The default value is 10, which means that the HTTP\nengine will attempt to retry a failed request up to 10 times before\ngiving up and returning an error to the caller. This parameter allows\ndevelopers to control the behavior of the HTTP engine in the face of\ntransient errors, providing a mechanism for automatically retrying\nrequests that may succeed on subsequent attempts.\n"
        - id: pintRetryDelay
          type: System.Int32
          description: "\nThis integer specifies the delay, <code>in seconds</code>, between retry\nattempts for a request that fails due to a transient error. The\ndefault value is <code>10</code>, which means that the HTTP engine will wait for\n10 seconds before attempting to retry a failed request. This\nparameter allows developers to control the timing of retry attempts,\nproviding a mechanism for introducing a delay between retries to\navoid overwhelming the server or network with rapid-fire requests.\nBy adjusting the retry delay, developers can optimize the balance\nbetween retrying failed requests and avoiding excessive delays in\nthe overall request processing.\n"
        - id: pdiLogCallback
          type: WizardWrx.HTTP.RequestOptions.HttpEngineLogCallback
          description: "\n<p>\nThis delegate is called to log messages from the HTTP engine. It is\noptional; if no delegate is provided, no logging occurs. \n</p>\n<p>\nIf logging is enabled, the delegate is expected to handle the log\nmessages appropriately, such as by writing them to a log file,\ndisplaying them in a console, or sending them to a logging service.\nThe additional parameters provide context about the source of the\nlog message, including the member name, source file path, and line\nnumber where the log message was generated. This information can be\nuseful for debugging and tracing the flow of execution in the HTTP\nengine, allowing developers to identify the specific location in the\ncode where the log message originated. The use of CallerMemberName,\nCaller FilePath, and CallerLineNumber attributes allows the HTTP\nengine to automatically capture this contextual information without\nrequiring the caller to explicitly provide it, making it easier to\nimplement logging throughout the codebase. Overall, this delegate\nprovides a flexible and powerful mechanism for logging messages from\nthe HTTP engine while also capturing important contextual\ninformation for debugging purposes.\n</p>\n"
      overload: WizardWrx.HTTP.RequestOptions.#ctor*
      modifiers:
        CSharp:
        - public
        VB:
        - Public
    - id: WizardWrx.HTTP.RequestOptions.ToString
      commentId: M:WizardWrx.HTTP.RequestOptions.ToString
      language: CSharp
      name:
        CSharp: ToString()
        VB: ToString()
      nameWithType:
        CSharp: RequestOptions.ToString()
        VB: RequestOptions.ToString()
      qualifiedName:
        CSharp: WizardWrx.HTTP.RequestOptions.ToString()
        VB: WizardWrx.HTTP.RequestOptions.ToString()
      type: Method
      assemblies:
      - WizardWrx.HTTP
      namespace: WizardWrx.HTTP
      source:
        remote:
          path: HTTP/RequestOptions.cs
          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API
        id: ToString
        path: ../HTTP/RequestOptions.cs
        startLine: 412
      summary: "\nThis override of the ToString method provides a string\nrepresentation of the RequestOptions instance, including the values\nof its properties. The string is formatted in a way that allows\ndevelopers to easily understand the configuration of the\nRequestOptions instance, making it easier to debug and troubleshoot\nissues related to HTTP requests. The method uses helper functions to\nformat the injected object reference and delegate information,\nensuring that the output is clear and informative. Overall, this\nToString override provides a valuable tool for developers to gain\ninsights into the state of the RequestOptions instance and\nunderstand how it is configured for use with the HTTP engine.\n"
      example: []
      syntax:
        content:
          CSharp: public override string ToString()
          VB: Public Overrides Function ToString As String
        return:
          type: System.String
          description: "\nSee the summary for details on the content and format of the\nreturned string.\n"
      overload: WizardWrx.HTTP.RequestOptions.ToString*
      overridden: System.Object.ToString
      modifiers:
        CSharp:
        - public
        - override
        VB:
        - Public
        - Overrides
  - id: WizardWrx.HTTP.RequestOptions.HttpEngineLogCallback
    commentId: T:WizardWrx.HTTP.RequestOptions.HttpEngineLogCallback
    language: CSharp
    name:
      CSharp: RequestOptions.HttpEngineLogCallback
      VB: RequestOptions.HttpEngineLogCallback
    nameWithType:
      CSharp: RequestOptions.HttpEngineLogCallback
      VB: RequestOptions.HttpEngineLogCallback
    qualifiedName:
      CSharp: WizardWrx.HTTP.RequestOptions.HttpEngineLogCallback
      VB: WizardWrx.HTTP.RequestOptions.HttpEngineLogCallback
    type: Delegate
    assemblies:
    - WizardWrx.HTTP
    namespace: WizardWrx.HTTP
    source:
      remote:
        path: HTTP/RequestOptions.cs
        branch: master
        repo: https://github.com/txwizard/WizardWrx_NET_API
      id: HttpEngineLogCallback
      path: ../HTTP/RequestOptions.cs
      startLine: 90
    summary: "\nThis property represents the delegate signature for the\n<C>optional</C> callback method that receives log messages from the\nHTTP Request engine to which this instance is attached. The callback\nmethod is expected to handle the log message appropriately, such as\nby writing it to a log file, displaying it in a console, or sending\nit to a logging service. The additional parameters provide context\nabout the source of the log message, including the member name,\nsource file path, and line number where the log message was\ngenerated. This information can be useful for debugging and tracing\nthe flow of execution in the HTTP engine, allowing developers to\nidentify the specific location in the code where the log message\noriginated. The use of CallerMemberName, CallerFilePath, and\nCallerLineNumber attributes allows the HTTP engine to automatically\ncapture this contextual information without requiring the caller to\nexplicitly provide it, making it easier to implement logging\nthroughout the codebase. Overall, this delegate provides a flexible\nand powerful mechanism for logging messages from the HTTP engine\nwhile also capturing important contextual information for debugging\npurposes.\n"
    example: []
    syntax:
      content:
        CSharp: public delegate void HttpEngineLogCallback(string pstrLogMessage, string memberName = "", string sourceFilePath = "", int sourceLineNumber = 0);
        VB: Public Delegate Sub HttpEngineLogCallback(pstrLogMessage As String, memberName As String = "", sourceFilePath As String = "", sourceLineNumber As Integer = 0)
      parameters:
      - id: pstrLogMessage
        type: System.String
        description: "\n<p>\nThis string represents the log message generated by the HTTP engine.\nThe content of the message can vary widely depending on the specific\nevents and actions taking place within the engine, such as the\ninitiation of a request, the receipt of a response, the occurrence\nof an error, or any other significant event that the engine deems\nworthy of logging. The message can include details about the request\nbeing processed, the response received, any exceptions encountered,\nor any other relevant information that can help developers under-\nstand the behavior of the HTTP engine and diagnose issues that may\narise during its operation. \n</p>\n<p>\nThe log message can be formatted in a way that is consistent with\nthe logging conventions used throughout the codebase, and may\ninclude timestamps, log levels, or other metadata to provide\nadditional context for the message. Overall, the log message\nparameter serves as a crucial means of communication between the\nHTTP engine and the logging system, allowing developers to gain\ninsights into the inner workings of the engine and troubleshoot any\nissues that may arise during its execution.\n</p>\n<p>\nAll messages begin with a prefix that identifies the call site of\nthe constructor or other method that reported it, so that log \nentries can be easily traced back to their origin.\n</p>\n<p>\nThe additional parameters, including memberName \n(<code data-dev-comment-type=\"paramref\" class=\"paramref\">pstrMemberName</code>), sourceFilePath\n(<code data-dev-comment-type=\"paramref\" class=\"paramref\">pstrSourceFilePath</code>), and sourceLineNumber \n(<code data-dev-comment-type=\"paramref\" class=\"paramref\">pintSourceLineNumber</code>), provide valuable context\nabout the source of the log message. The memberName parameter\nindicates the name of the method or property where the log message\nwas generated within the HTTP engine, allowing developers to\npinpoint the specific location in the code that is responsible for\nthe log message. The sourceFilePath parameter provides the file path\nof the source code file where the log message originated, which can\nbe helpful for navigating to the relevant code when investigating\nissues. The sourceLineNumber parameter indicates the line number\nwithin the source code file where the log message was generated,\nproviding precise information about the location where the message\noriginated. Together, these parameters enable developers to quickly\nand efficiently trace the flow of execution within the HTTP engine\nand identify any potential issues or areas for improvement based on\nthe logged messages.\n</p>\n"
      - id: memberName
        type: System.String
      - id: sourceFilePath
        type: System.String
      - id: sourceLineNumber
        type: System.Int32
    modifiers:
      CSharp:
      - public
      - delegate
      VB:
      - Public
      - Delegate
    items: []
  - id: WizardWrx.HTTP.RequestOptions.OAuthTokenGetter
    commentId: T:WizardWrx.HTTP.RequestOptions.OAuthTokenGetter
    language: CSharp
    name:
      CSharp: RequestOptions.OAuthTokenGetter
      VB: RequestOptions.OAuthTokenGetter
    nameWithType:
      CSharp: RequestOptions.OAuthTokenGetter
      VB: RequestOptions.OAuthTokenGetter
    qualifiedName:
      CSharp: WizardWrx.HTTP.RequestOptions.OAuthTokenGetter
      VB: WizardWrx.HTTP.RequestOptions.OAuthTokenGetter
    type: Delegate
