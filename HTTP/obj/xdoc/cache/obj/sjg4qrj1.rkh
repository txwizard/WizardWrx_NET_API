      source:
        remote:
          path: HTTP/RequestOptions.cs
          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API
        id: LoggerCallback
        path: ../HTTP/RequestOptions.cs
        startLine: 260
      summary: "\n<p>\nThis read-only property returns a delegate that receives log\nmessages from the HTTP engine to which this instance is attached.\n</p>\n<p>\nThe callback method is expected to handle the log messages\nappropriately, such as by writing them to a log file, displaying\nthem in a console, or sending them to a logging service. The\nadditional parameters provide context about the source of the\nlog message, including the member name, source file path, and\nline number where the log message was generated. This information\ncan be useful for debugging and tracing the flow of execution in the\nHTTP engine, allowing developers to identify the specific location\nin the code where the log message originated. The use of\nCallerMemberName, CallerFilePath, and CallerLineNumber attributes\nallows the HTTP engine to automatically capture this contextual\ninformation without requiring the caller to explicitly provide it,\nmaking it easier to implement logging throughout the codebase.\n</p>\n<p>\nThis delegate provides a flexible and powerful mechanism for\nlogging messages from the HTTP engine while also capturing\nimportant contextual information for debugging purposes.\n</p>\n"
      example: []
      syntax:
        content:
          CSharp: public RequestOptions.HttpEngineLogCallback LoggerCallback { get; }
          VB: Public ReadOnly Property LoggerCallback As RequestOptions.HttpEngineLogCallback
        parameters: []
        return:
          type: WizardWrx.HTTP.RequestOptions.HttpEngineLogCallback
      overload: WizardWrx.HTTP.RequestOptions.LoggerCallback*
      modifiers:
        CSharp:
        - public
        - get
        VB:
        - Public
        - ReadOnly
    - id: WizardWrx.HTTP.RequestOptions.RetryDelay
      commentId: P:WizardWrx.HTTP.RequestOptions.RetryDelay
      language: CSharp
      name:
        CSharp: RetryDelay
        VB: RetryDelay
      nameWithType:
        CSharp: RequestOptions.RetryDelay
        VB: RequestOptions.RetryDelay
      qualifiedName:
        CSharp: WizardWrx.HTTP.RequestOptions.RetryDelay
        VB: WizardWrx.HTTP.RequestOptions.RetryDelay
      type: Property
      assemblies:
      - WizardWrx.HTTP
      namespace: WizardWrx.HTTP
      source:
        remote:
          path: HTTP/RequestOptions.cs
          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API
        id: RetryDelay
        path: ../HTTP/RequestOptions.cs
        startLine: 275
      summary: "\nThis read-only integer property specifies the delay, <code>in\nseconds</code>, between retry attempts for a request that fails due to\na transient error. The default value is <code>10</code>, which means that\nthe HTTP engine will wait for 10 seconds before attempting to retry\na failed request. This parameter allows developers to control the\ntiming of retry attempts, providing a mechanism for introducing a\ndelay between retries to avoid overwhelming the server or network\nwith rapid-fire requests. By adjusting the retry delay, developers\ncan optimize the balance between retrying failed requests and\navoiding excessive delays in the overall request processing.\n"
      example: []
      syntax:
        content:
          CSharp: public int RetryDelay { get; }
          VB: Public ReadOnly Property RetryDelay As Integer
        parameters: []
        return:
          type: System.Int32
      overload: WizardWrx.HTTP.RequestOptions.RetryDelay*
      modifiers:
        CSharp:
        - public
        - get
        VB:
        - Public
        - ReadOnly
    - id: WizardWrx.HTTP.RequestOptions.RetryLimit
      commentId: P:WizardWrx.HTTP.RequestOptions.RetryLimit
      language: CSharp
      name:
        CSharp: RetryLimit
        VB: RetryLimit
      nameWithType:
        CSharp: RequestOptions.RetryLimit
        VB: RequestOptions.RetryLimit
      qualifiedName:
        CSharp: WizardWrx.HTTP.RequestOptions.RetryLimit
        VB: WizardWrx.HTTP.RequestOptions.RetryLimit
      type: Property
      assemblies:
      - WizardWrx.HTTP
      namespace: WizardWrx.HTTP
      source:
        remote:
          path: HTTP/RequestOptions.cs
          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API
        id: RetryLimit
        path: ../HTTP/RequestOptions.cs
        startLine: 289
      summary: "\nThis read-only integer property specifies the maximum number of times\nto retry a request that fails due to a transient error, such as a\nnetwork issue or a server error. The default value is 10, which\nmeans that the HTTP engine will attempt to retry a failed request up\nto 10 times before giving up and returning an error to the caller.\nThis parameter allows developers to control the behavior of the HTTP\nengine in the face of transient errors, providing a mechanism for\nautomatically retrying requests that may succeed on subsequent\nattempts.\n"
      example: []
      syntax:
        content:
          CSharp: public int RetryLimit { get; }
          VB: Public ReadOnly Property RetryLimit As Integer
        parameters: []
        return:
          type: System.Int32
      overload: WizardWrx.HTTP.RequestOptions.RetryLimit*
      modifiers:
        CSharp:
        - public
        - get
        VB:
        - Public
        - ReadOnly
