    - id: WizardWrx.HTTP.RequestOptions.LoggerCallback
      commentId: P:WizardWrx.HTTP.RequestOptions.LoggerCallback
      language: CSharp
      name:
        CSharp: LoggerCallback
        VB: LoggerCallback
      nameWithType:
        CSharp: RequestOptions.LoggerCallback
        VB: RequestOptions.LoggerCallback
      qualifiedName:
        CSharp: WizardWrx.HTTP.RequestOptions.LoggerCallback
        VB: WizardWrx.HTTP.RequestOptions.LoggerCallback
      type: Property
