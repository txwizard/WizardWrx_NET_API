    - id: WizardWrx.HTTP.RequestOptions.LogCallback
      commentId: P:WizardWrx.HTTP.RequestOptions.LogCallback
      language: CSharp
      name:
        CSharp: LogCallback
        VB: LogCallback
      nameWithType:
        CSharp: RequestOptions.LogCallback
        VB: RequestOptions.LogCallback
      qualifiedName:
        CSharp: WizardWrx.HTTP.RequestOptions.LogCallback
        VB: WizardWrx.HTTP.RequestOptions.LogCallback
      type: Property
      assemblies:
      - WizardWrx.HTTP
      namespace: WizardWrx.HTTP
      source:
        remote:
          path: HTTP/RequestOptions.cs
          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API
        id: LogCallback
        path: ../HTTP/RequestOptions.cs
        startLine: 170
      summary: "\nThis read-only property returns a delegate that processes log\nmessages generated by the HTTP engine. The delegate is expected to\nhandle the log messages appropriately, such as by writing them to a\nlog file, displaying them in a console, or sending them to a logging\nservice. The additional parameters provide context about the source\nof the log message, including the member name, source file path, and\nline number where the log message was generated. This information can\nbe useful for debugging and tracing the flow of execution in the HTTP\nengine, allowing developers to identify the specific location in the\ncode where the log message originated. The use of CallerMemberName,\nCallerFilePath, and CallerLineNumber attributes allows the HTTP\nengine to automatically capture this contextual information without\nrequiring the caller to explicitly provide it, making it easier to\nimplement logging throughout the codebase. Overall, this delegate\nprovides a flexible and powerful mechanism for logging messages from\nthe HTTP engine while also capturing important contextual\ninformation for debugging purposes.\n"
      example: []
      syntax:
        content:
          CSharp: public RequestOptions.HttpEngineLogCallback LogCallback { get; }
          VB: Public ReadOnly Property LogCallback As RequestOptions.HttpEngineLogCallback
        parameters: []
        return:
          type: WizardWrx.HTTP.RequestOptions.HttpEngineLogCallback
      overload: WizardWrx.HTTP.RequestOptions.LogCallback*
      modifiers:
        CSharp:
        - public
        - get
        VB:
        - Public
        - ReadOnly
