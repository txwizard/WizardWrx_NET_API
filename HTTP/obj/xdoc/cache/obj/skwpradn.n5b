      commentId: M:WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsInt(System.String)
      language: CSharp
      name:
        CSharp: GetFieldValueAsInt(String)
        VB: GetFieldValueAsInt(String)
