        id: GetFieldValueAsString
        path: ../HTTP/JSON_Deserialized_Object.cs
        startLine: 548
      summary: "\nQuery the JSON object for a specific field and returns its value as\na string, or null if the field does not exist or is not a string.\n"
      remarks: "\n<p>\nThis method provides the canonical string accessor for this class.\n</p>\n<p>\nJSON string tokens map directly to .NET strings, and JSON does not\ndistinguish between different textual subtypes (such as char, multiline\ntext, or encoded binary). Additional getters for narrower textual types\nwould not add meaningful capability, since callers who require a more\nspecific representation can interpret or validate the returned string\nas needed.\n</p>\n"
      example: []
      syntax:
        content:
          CSharp: public string GetFieldValueAsString(string pstrFieldName)
          VB: Public Function GetFieldValueAsString(pstrFieldName As String) As String
        parameters:
        - id: pstrFieldName
          type: System.String
          description: "\nThis string represents the name of the field for which to check.\n"
        return:
          type: System.String
          description: "\nThe return value is a string representing the value of the field,\nor null if the field does not exist or is not a string.\n"
      overload: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsString*
      modifiers:
        CSharp:
        - public
        VB:
        - Public
