        path: ../HTTP/JSON_Deserialized_Object.cs
        startLine: 693
      summary: "\n<p>\nValidate that the JSON object contains all required fields.\n</p>\n<p>\nOptionally enforces that the values are non-empty (non-null, non-\nwhitespace).\n</p>\n<p>\nField name matching is case-insensitive.\n</p>\n"
      example: []
      syntax:
        content:
          CSharp: public List<string> Validate(bool pfRequireNonEmptyValues)
          VB: Public Function Validate(pfRequireNonEmptyValues As Boolean) As List(Of String)
        parameters:
        - id: pfRequireNonEmptyValues
          type: System.Boolean
          description: "\nThis flag indicates whether to enforce that the required fields have non-\nempty values. If <code>true</code>, then any required field that is either null\nor a string consisting only of whitespace will be considered missing.\n"
        return:
          type: System.Collections.Generic.List{System.String}
          description: "\nThis method returns a list of missing required fields. If the JSON\ndocument is invalid, the list will contain a single entry &quot;**Invalid\nJSON**&quot;. If all required fields are present (and non-empty when\nrequired), the returned list is empty.\n"
      overload: WizardWrx.HTTP.JSON_Deserialized_Object.Validate*
      modifiers:
        CSharp:
        - public
        VB:
        - Public
