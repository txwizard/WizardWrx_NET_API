        VB: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsInt(System.String)
      type: Method
      assemblies:
      - WizardWrx.HTTP
      namespace: WizardWrx.HTTP
      source:
        remote:
          path: HTTP/JSON_Deserialized_Object.cs
          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API.git
        id: GetFieldValueAsInt
        path: ../HTTP/JSON_Deserialized_Object.cs
        startLine: 491
      summary: "\nQuery the JSON object for a specific field and return its value as\nan integer, or null if the field does not exist or cannot be parsed\nas a 32-bit signed integer.\n"
      remarks: "\n<p>\nThis method provides the canonical integer accessor for this class.\n</p>\n<p>\nThis method retrieves the field value as a 32-bit integer. JSON does\nnot define distinct numeric widths, and JSON.NET represents all\ninteger tokens internally as Int64. This method returns the value\nonly when it fits safely within the range of Int32. Smaller integer\ntypes (byte, short) are subsets of Int32 and do not require separate\ngetters, since callers who need them can cast the returned value. \n</p>\n<p>\nA 64-bit integer getter is intentionally omitted because JSON does\nnot guarantee that numeric values fall within the precise range of\nInt64. Callers who require 64-bit semantics should parse the raw\nstring explicitly, using <xref href=\"System.Int64.Parse(System.String)\" data-throw-if-not-resolved=\"false\"></xref>.\n</p>\n"
      example: []
      syntax:
        content:
          CSharp: public int? GetFieldValueAsInt(string pstrFieldName)
          VB: Public Function GetFieldValueAsInt(pstrFieldName As String) As Integer?
        parameters:
        - id: pstrFieldName
          type: System.String
          description: "\nThis string represents the name of the field for which to check.\n"
        return:
          type: System.Nullable{System.Int32}
          description: "\nThe return value is a nullable integer representing the value of the field,\nor null if the field does not exist or cannot be parsed as an integer.\n"
      overload: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsInt*
      modifiers:
        CSharp:
        - public
        VB:
        - Public
      references:
        System.Int64.Parse(System.String): 
