        VB: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsBoolean(System.String)
      type: Method
      assemblies:
      - WizardWrx.HTTP
      namespace: WizardWrx.HTTP
      source:
        remote:
          path: HTTP/JSON_Deserialized_Object.cs
          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API.git
        id: GetFieldValueAsBoolean
        path: ../HTTP/JSON_Deserialized_Object.cs
        startLine: 314
      summary: "\nQuery the JSON object for a specific field and attempt to parse it\nas a Boolean.\n"
      remarks: "\nJSON has a native Boolean type, and JSON.NET preserves it directly, so this\naccessor returns true or false only when the underlying token is a JSON\nBoolean or a string that .NET recognizes as a Boolean literal (“true” or\n“false”, case-insensitive). JSON.NET does not coerce other string values\nto Boolean, and the .NET framework does not define truthy/falsy semantics\nfor values such as “yes”, “no”, “0”, or “1”. Callers who require more\nflexible Boolean interpretation should retrieve the raw string and apply\ndomain-specific rules.\n"
      example: []
      syntax:
        content:
          CSharp: public bool? GetFieldValueAsBoolean(string pstrFieldName)
          VB: Public Function GetFieldValueAsBoolean(pstrFieldName As String) As Boolean?
        parameters:
        - id: pstrFieldName
          type: System.String
          description: "\nThis string represents the name of the field for which to check.\n"
        return:
          type: System.Nullable{System.Boolean}
          description: "\nThe return value is a nullable Boolean representing the value of the\nfield, or null if the field does not exist or cannot be parsed as a\nBoolean.\n"
      overload: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsBoolean*
      modifiers:
        CSharp:
        - public
        VB:
        - Public
    - id: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsDateTime(System.String)
      commentId: M:WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsDateTime(System.String)
      language: CSharp
