          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API.git
        id: GetFieldValueAsDateTime
        path: ../HTTP/JSON_Deserialized_Object.cs
        startLine: 365
      summary: "\nQuery the JSON object for a specific field and attempt to parse it\nas a DateTime.\n"
      remarks: "\n<p>\nThis method provides the canonical double precision floating point\nnumber accessor for this class.\n</p>\n<p>\nThis method retrieves the field value as a DateTime. Since JSON has\nno native date or time type, and date values are represented as\nstrings. This method parses those strings using \n<xref href=\"System.DateTime.TryParse(System.String%2cSystem.DateTime%40)\" data-throw-if-not-resolved=\"false\"></xref>, which is \nsufficient for ingestion scenarios where the exact original offset\nis not required and the primary goal is to obtain a usable DateTime\nvalue.\n</p>\n<p>\nA DateTimeOffset getter is intentionally omitted because JSON does not\nguarantee the presence or meaning of timezone offsets, and callers who\nrequire offset-preserving semantics can parse the raw string explicitly\nusing <xref href=\"System.DateTimeOffset.Parse(System.String)\" data-throw-if-not-resolved=\"false\"></xref>.\n</p>\n"
      example: []
      syntax:
        content:
          CSharp: public DateTime? GetFieldValueAsDateTime(string pstrFieldName)
          VB: Public Function GetFieldValueAsDateTime(pstrFieldName As String) As Date?
        parameters:
        - id: pstrFieldName
          type: System.String
          description: "\nThis string represents the name of the field for which to check.\n"
        return:
          type: System.Nullable{System.DateTime}
          description: "\nThe return value is a nullable DateTime representing the value of\nthe field, or null if the field does not exist or cannot be parsed\nas a DateTime.\n"
      overload: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsDateTime*
      modifiers:
        CSharp:
        - public
        VB:
        - Public
      references:
        System.DateTime.TryParse(System.String,System.DateTime@): 
        System.DateTimeOffset.Parse(System.String): 
    - id: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsDouble(System.String)
      commentId: M:WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsDouble(System.String)
      language: CSharp
      name:
        CSharp: GetFieldValueAsDouble(String)
        VB: GetFieldValueAsDouble(String)
      nameWithType:
        CSharp: JSON_Deserialized_Object.GetFieldValueAsDouble(String)
        VB: JSON_Deserialized_Object.GetFieldValueAsDouble(String)
      qualifiedName:
        CSharp: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsDouble(System.String)
        VB: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsDouble(System.String)
      type: Method
      assemblies:
      - WizardWrx.HTTP
      namespace: WizardWrx.HTTP
      source:
        remote:
          path: HTTP/JSON_Deserialized_Object.cs
          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API.git
        id: GetFieldValueAsDouble
        path: ../HTTP/JSON_Deserialized_Object.cs
        startLine: 405
      summary: "\nQuery the JSON object for a specific field and returns its value as\na double, or null if the field does not exist or cannot be parsed as\na double.\n"
      remarks: "\n<p>\nThis method provides the canonical double precision floating point\nnumber accessor for this class.\n</p>\n<p>\nJSON numeric values are represented internally as doubles, and every\nvalid float value is also representable as a double. Because double is\nstrictly a superset of float in both range and precision, there is no\nscenario where a separate GetFieldValueAsFloat method would return a\nmeaningful result that this method cannot.\n</p>\n<p>\nCallers who require a float can cast the returned double value.\n</p>\n"
      example: []
      syntax:
        content:
          CSharp: public double? GetFieldValueAsDouble(string pstrFieldName)
          VB: Public Function GetFieldValueAsDouble(pstrFieldName As String) As Double?
        parameters:
        - id: pstrFieldName
          type: System.String
          description: "\nThis string represents the name of the field for which to get the\nvalue. The method will attempt to parse the value of this field as a\ndouble.\n"
        return:
          type: System.Nullable{System.Double}
          description: "\nThe return value is a nullable double representing the value of the field,\nor null if the field does not exist or cannot be parsed as a double.\n"
      overload: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsDouble*
      modifiers:
        CSharp:
        - public
        VB:
        - Public
    - id: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsGuid(System.String)
      commentId: M:WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsGuid(System.String)
      language: CSharp
      name:
        CSharp: GetFieldValueAsGuid(String)
        VB: GetFieldValueAsGuid(String)
      nameWithType:
        CSharp: JSON_Deserialized_Object.GetFieldValueAsGuid(String)
        VB: JSON_Deserialized_Object.GetFieldValueAsGuid(String)
      qualifiedName:
        CSharp: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsGuid(System.String)
        VB: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsGuid(System.String)
      type: Method
      assemblies:
      - WizardWrx.HTTP
      namespace: WizardWrx.HTTP
      source:
        remote:
          path: HTTP/JSON_Deserialized_Object.cs
          branch: master
          repo: https://github.com/txwizard/WizardWrx_NET_API.git
        id: GetFieldValueAsGuid
        path: ../HTTP/JSON_Deserialized_Object.cs
        startLine: 450
      summary: "\nQuery the JSON object for a specific field and attempt to parse it\nas a Guid.\n"
      remarks: "\n<p>\nThis method retrieves the field value as a Guid, which is a common\nrepresentation for identifiers in many JSON-based systems. JSON has no\nnative Guid type, so values are stored as strings and parsed here using\n<xref href=\"System.Guid.TryParse(System.String%2cSystem.Guid%40)\" data-throw-if-not-resolved=\"false\"></xref>.\n</p>\n<p>\nAdditional identifier getters (such as UInt64 or custom ID formats)\nare intentionally omitted, since callers with domain-specific\nidentifier requirements should interpret the raw string according to\ntheir own rules.\n</p>\n"
      example: []
      syntax:
        content:
          CSharp: public Guid? GetFieldValueAsGuid(string pstrFieldName)
          VB: Public Function GetFieldValueAsGuid(pstrFieldName As String) As Guid?
        parameters:
        - id: pstrFieldName
          type: System.String
          description: "\nThis string represents the name of the field for which to get the\nvalue. The method will attempt to parse the value of this field as a\nGuid.\n"
        return:
          type: System.Nullable{System.Guid}
          description: "\nThe return value is a nullable Guid representing the value of the field,\nor null if the field does not exist or cannot be parsed as a Guid.\n"
      overload: WizardWrx.HTTP.JSON_Deserialized_Object.GetFieldValueAsGuid*
      modifiers:
        CSharp:
        - public
        VB:
        - Public
      references:
        System.Guid.TryParse(System.String,System.Guid@): 
